# Variables de entorno del proyecto
PYTHONPATH=${PYTHONPATH}:..

# === SQL Server (activo) ===
MSSQL_HOST=tu_host
MSSQL_USER=usuario
MSSQL_PASSWORD=password
# Opcionales: déjalos vacíos si no aplican (p. ej. DataWarehouse sin una única base de datos)
MSSQL_NAME=
MSSQL_PORT=

